{
    "name": "javaabu/workflows",
    "description": "Dynamic workflows for Laravel: versioned workflow definitions with steps, transitions, assignees and conditions, instances with tasks, history and events, fluent definitions you can seed, a keyboard-accessible drag-and-drop builder in Inertia React and Blade, developer-defined actions, step data collected with javaabu/form-builder forms, a workflow tester and an optional AI assistant",
    "homepage": "https://github.com/Javaabu/workflows",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "workflows",
        "workflow-engine",
        "approvals",
        "form-builder",
        "inertia",
        "react",
        "dhivehi"
    ],
    "authors": [
        {
            "name": "Javaabu Pvt. Ltd.",
            "email": "info@javaabu.com",
            "homepage": "https://javaabu.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "javaabu/form-builder": "^1.0@dev",
        "javaabu/forms": "^2.0@dev",
        "javaabu/manifest": "^1.0@dev",
        "javaabu/permissions": "^3.0@dev",
        "javaabu/stencil": "^1.0@dev"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^2.0",
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "javaabu/notifications": "^1.0@dev",
        "javaabu/translatable": "^3.0@dev",
        "laravel/ai": "^1.3",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Renders the pages with Inertia React when workflows.views is inertia (^2.0)",
        "javaabu/notifications": "The notify action sends javaabu/notifications notifications: every channel, the bell, preferences (^1.0)",
        "javaabu/translatable": "Workflow names, step names and transition labels in every language (^3.0)",
        "laravel/ai": "The assistant that builds or changes a workflow from a description (^1.3)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Workflows\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Workflows\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Workflows\\WorkflowsServiceProvider"
            ],
            "aliases": {
                "Workflows": "Javaabu\\Workflows\\Facades\\Workflows"
            }
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/form-builder"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/notifications"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/stencil"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/translatable"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
